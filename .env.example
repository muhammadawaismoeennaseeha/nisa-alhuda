# ─────────────────────────────────────────────────────────────
# Nisa Al-Huda — environment variables
#
# Next.js reads .env.local and nothing else. Rather than hand-editing it,
# keep one profile per backend and switch between them:
#
#     npm run env:local     # local Supabase stack (Docker)  -> .env.stack-local
#     npm run env:hosted    # hosted Supabase project        -> .env.stack-hosted
#
# Every one of those files is gitignored. This example is the only one
# committed, and it must never contain a real key.
# ─────────────────────────────────────────────────────────────


# ─── Supabase (required) ─────────────────────────────────────
# Local stack:  http://127.0.0.1:54321   (see: supabase status)
# Hosted:       https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe in the browser — the RLS policies are what
# actually protect the data. Used by src/lib/supabase/client.ts and
# src/lib/supabase/server.ts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — bypasses every RLS policy. Used by
# src/lib/supabase/admin.ts, the cron routes, and scripts/*.ts.
# Never prefix this one with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Site URL (required) ─────────────────────────────────────
# Absolute origin, no trailing slash. Builds the auth-callback redirect
# (src/app/auth/callback/route.ts) and every link inside transactional
# email (src/lib/email.ts).
# Local: http://localhost:3000   Production: https://www.nisaalhuda.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── Email / Resend (optional in dev) ────────────────────────
# Unset means every email is skipped with a console warning and nothing
# throws, so the app still works. Leave blank unless you are specifically
# testing email.
RESEND_API_KEY=

# From-header for transactional mail. Falls back to
# "Nisa Al-Huda <onboarding@resend.dev>" when unset.
EMAIL_FROM=


# ─── Cron (optional in dev) ──────────────────────────────────
# Shared secret for the /api/cron/* routes, which expect
# `Authorization: Bearer <CRON_SECRET>`. Unset means those routes return
# 500 instead of running, which is the safe local default.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# End-to-end (Playwright) admin login.
# Overrides the LOCAL-ONLY defaults in tests/e2e/_credentials.ts.
# Required for any hosted/CI run; leave blank to use the local seed defaults.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADMIN_FULL_NAME=
